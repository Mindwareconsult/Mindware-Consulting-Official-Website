{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 10
    }
  },
  "redirects": [
    {
      "source": "/business-growth-season",
      "destination": "/business-growth-season-2026/",
      "statusCode": 301
    },
    {
      "source": "/business-growth-season/",
      "destination": "/business-growth-season-2026/",
      "statusCode": 301
    },
    {
      "source": "/campaigns/business-growth-season-2026",
      "destination": "/business-growth-season-2026/",
      "statusCode": 301
    },
    {
      "source": "/campaigns/business-growth-season-2026/",
      "destination": "/business-growth-season-2026/",
      "statusCode": 301
    },
    {
      "source": "/campaign",
      "destination": "/business-growth-season-2026/",
      "statusCode": 301
    },
    {
      "source": "/campaign/",
      "destination": "/business-growth-season-2026/",
      "statusCode": 301
    }
  ],
  "rewrites": [
    {
      "source": "/business-growth-season-2026",
      "destination": "/business-growth-season-2026/index.html"
    },
    {
      "source": "/business-growth-season-2026/",
      "destination": "/business-growth-season-2026/index.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
