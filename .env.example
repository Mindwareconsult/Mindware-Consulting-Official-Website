# ==============================================================================
# Mindware Consulting Ltd — Environment Configuration Template
# Copy to .env for local development. Configure Production secrets in Vercel.
# NEVER expose private server credentials via VITE_* prefixes.
# ==============================================================================

# --- AI Writing Assistance (Server-Side Only) ---------------------------------
GEMINI_API_KEY=

# --- Application URL ----------------------------------------------------------
APP_URL=https://mindwareconsult.com.ng

# --- Supabase PostgreSQL Persistence (Server-Side Only) -----------------------
# Required in production/Vercel. In local development, leaving blank enables
# local NDJSON persistence under data/submissions/*.ndjson.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend Transactional Email Notifications (Server-Side Only) --------------
RESEND_API_KEY=
ENQUIRY_FROM_EMAIL=Mindware Growth Desk <no-reply@mindwareconsult.com.ng>
ENQUIRY_NOTIFICATION_EMAIL=contact@mindwareconsult.com.ng
CAREERS_NOTIFICATION_EMAIL=contact@mindwareconsult.com.ng

# --- Distributed Rate Limiting via Upstash Redis REST (Server-Side Only) ------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_SALT=

# --- Outbox Worker & Signed Unsubscribe Tokens (Server-Side Only) -------------
# Vercel Cron Jobs invoke GET /api/internal/process-outbox using Authorization: Bearer $CRON_SECRET.
# Preview deployments require manual authenticated GET/POST invocation; Vercel Crons run on Production only.
CRON_SECRET=
NEWSLETTER_SIGNING_SECRET=
# Optional previous HMAC secret accepted during zero-downtime key rotation
NEWSLETTER_PREVIOUS_SIGNING_SECRET=

# --- External CRM / Webhook Endpoints (HTTPS Only, Server-Side) ---------------
ENQUIRY_WEBHOOK_URL=
CAREERS_WEBHOOK_URL=
# Comma-separated trusted host allowlist (e.g. hooks.zapier.com,hook.eu1.make.com)
WEBHOOK_ALLOWED_HOSTS=

# --- Client-Side Analytics & Conversion Tracking (Public Vite Vars Only) ------
VITE_GA4_MEASUREMENT_ID=
VITE_GTM_CONTAINER_ID=
VITE_META_PIXEL_ID=
